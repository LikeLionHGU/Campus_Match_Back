# 이 파일을 .env 로 복사해서 실제 값을 채운다. .env 는 GitHub에 올리지 않는다.
DB_ROOT_PASSWORD=change-me

# JWT 서명 키 (긴 랜덤 문자열, 예: openssl rand -base64 64)
JWT_SECRET=change-me

# S3 (프로필/갤러리 이미지 업로드)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# 이메일 인증 코드 발송 (Gmail이면 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=
